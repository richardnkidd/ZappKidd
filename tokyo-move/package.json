{
  "name": "kadode",
  "version": "0.1.0",
  "private": true,
  "description": "Kadode — a private two-person planning home for a staged household move to Tokyo.",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "tsx src/server/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:migrate": "tsx scripts/migrate.ts",
    "import": "tsx scripts/import.ts",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "export": "tsx scripts/export.ts",
    "backup": "tsx scripts/backup.ts",
    "restore": "tsx scripts/restore.ts",
    "user:password": "tsx scripts/set-password.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "@fastify/helmet": "13.2.0",
    "@fastify/static": "10.1.8",
    "@fontsource-variable/inter": "5.2.6",
    "@fontsource/noto-serif-jp": "5.2.6",
    "@fontsource/source-serif-4": "5.2.8",
    "better-sqlite3": "12.4.1",
    "fast-xml-parser": "5.11.2",
    "fastify": "5.12.7",
    "fflate": "0.8.3",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-router": "7.18.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@testing-library/react": "16.3.0",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "22.18.6",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "4.7.0",
    "jsdom": "26.1.0",
    "tsx": "4.20.5",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  }
}
